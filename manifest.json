{
  "manifest_version": 3,
  "name": "Fuck P小将",
  "version": "0.1.12",
  "description": "在 GMGN 代币 K 线页标注畜生地址持仓脏度。占比越高越脏。非官方。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Fuck P小将",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://gmgn.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://gmgn.ai/*"],
      "js": ["inject-gmgn.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://gmgn.ai/*"],
      "js": ["content-gmgn.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
